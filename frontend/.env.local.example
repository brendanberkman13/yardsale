# Copy this file to .env.local and fill in real values.
# .env.local is gitignored; .env.local.example is committed.

# Generate with: npx auth secret  (or `openssl rand -base64 32`)
AUTH_SECRET=

# Google OAuth client (https://console.cloud.google.com/auth/clients)
# Authorized redirect URI must include: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
